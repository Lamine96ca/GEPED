# gePed — modèle du fichier .env de PRODUCTION (o2switch)
# Copier ce fichier en « .env » à la racine du projet sur le serveur, puis remplir les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur Git (il contient des mots de passe).

# --- Mode et sécurité ---------------------------------------------------------
GPED_DEBUG=0
# Clé secrète : une longue chaîne aléatoire, différente de celle du poste de développement.
# La générer sur le serveur : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
GPED_SECRET_KEY=
# Domaine(s) du site, séparés par des virgules
GPED_ALLOWED_HOSTS=geped.gbelya-tech.com
# Adresse publique (QR codes des documents, liens des e-mails) : en https
GPED_URL_PUBLIQUE=https://geped.gbelya-tech.com
# HSTS : laisser 0 au début ; mettre 31536000 (1 an) une fois le HTTPS vérifié
GPED_HSTS_SECONDES=0

# --- Base MySQL (cPanel → Bases de données MySQL) ------------------------------
# Chez o2switch, le nom de la base et de l'utilisateur commencent par l'identifiant cPanel (ex. moncompte_geped)
GPED_DB_NAME=moncompte_geped
GPED_DB_USER=moncompte_geped
GPED_DB_PASSWORD=
GPED_DB_HOST=localhost
GPED_DB_PORT=3306

# --- Fichiers servis directement par Apache (dossier public du domaine) ---------
# Chemins ABSOLUS, dans le dossier racine du domaine choisi dans cPanel
GPED_STATIC_ROOT=/home/moncompte/geped.gbelya-tech.com/static
GPED_MEDIA_ROOT=/home/moncompte/geped.gbelya-tech.com/media

# --- E-mails (cPanel → Comptes de messagerie : créer no-reply@gbelya-tech.com) -----
# Serveur SMTP : celui indiqué par cPanel (« Connecter des appareils »), souvent mail.gbelya-tech.com
GPED_EMAIL_HOST=mail.gbelya-tech.com
GPED_EMAIL_PORT=465
GPED_EMAIL_SSL=1
GPED_EMAIL_USER=no-reply@gbelya-tech.com
GPED_EMAIL_PASSWORD=
GPED_EMAIL_FROM=gePed - IST de Mamou <no-reply@gbelya-tech.com>
# Adresses prévenues en cas d'erreur du serveur (séparées par des virgules)
GPED_ADMINS=informatique@gbelya-tech.com
